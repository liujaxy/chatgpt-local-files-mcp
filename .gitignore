# Public source allowlist; review new files before allowing them.
/*
!/.gitignore
!/README.md
!/使用说明.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/启动.cmd
!/control.py
!/reader.py
!/server.py
!/workflow.py
!/make_sample.py
!/requirements.lock.txt
!/tests/
/tests/*
!/tests/test_control.py
!/tests/test_reader.py
!/sample-project/
/sample-project/*
!/sample-project/说明.md
!/sample-project/资料/
/sample-project/资料/*
!/sample-project/资料/更新测试.md
!/sample-project/资料/图片/
/sample-project/资料/图片/*
!/sample-project/资料/图片/visual-check.png
!/vendor/
/vendor/*
!/vendor/tunnel-release.json
!/vendor/SHA256SUMS.txt
!/vendor/tunnel/
/vendor/tunnel/*
!/vendor/tunnel/LICENSE
!/vendor/tunnel/NOTICE
!/vendor/tunnel/tunnel-client-v0.0.14-windows-amd64-licenses.txt
**/state/
**/.env
**/.env.*
**/*.dpapi
**/*.pem
**/*.key
**/*.log
**/__pycache__/
**/.pytest_cache/
**/*.pyc
